---
// src/pages/about.astro
import Layout from "../layouts/Layout.astro";

// Fetch data from my backend API using environment variable
const backendUrl = import.meta.env.VITE_BACKEND_API_URL;
const response = await fetch(`${backendUrl}/clients/about`);
const photographerData = await response.json();
---

<Layout title="Sobre el Proyecto">
  <h1 class="text-2xl font-bold mb-4">Sobre el Proyecto</h1>
  <p class="mb-6">
    Este proyecto es una demostración de mis trabajos como fotógrafo.
  </p>

  {
    photographerData?.map(
      (person: {
        name: string;
        specialty: string;
        location: string;
        bio: string;
      }) => (
        <section class="mb-4 p-4 border rounded">
          <h2 class="text-xl font-semibold">{person.name}</h2>
          <p>
            <strong>Especialidad:</strong> {person.specialty}
          </p>
          <p>
            <strong>Ubicación:</strong> {person.location}
          </p>
          <p>
            <strong>Biografía:</strong> {person.bio}
          </p>
        </section>
      )
    )
  }
</Layout>
